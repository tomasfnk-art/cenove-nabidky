  "narrative": {
    "northStar": "Approved quotation workspace",
    "overview": "The approved quotation workspace combines a near-black plum canvas with blue-violet and burgundy ambient gradients. Quiet, opaque form panels support concentrated editing; violet identifies primary actions and pink gives totals a clear visual role. The light theme preserves that relationship with pale plum surroundings and white panels.\n\nThe approved visual reference is `exec-90015145-8b52-4cca-a1a3-238a5942f2b4.png`. This document refreshes the existing approved direction from the built `theme.css`, base styles in `index.html`, and theme behavior in `workspace.js`. It records established behavior rather than introducing a new visual concept.",
    "keyCharacteristics": [
      "Plum atmosphere around quiet form panels.",
      "Violet primary actions and pink quotation totals.",
      "System typography, compact rows, and clearly aligned numeric columns.",
      "A right-hand desktop summary, compact mobile editing, and white A4 output."
    ],
    "rules": [
      {
        "name": "The Ambient Canvas Rule",
        "body": "Keep blue-violet and burgundy gradients on the page and header; form panels stay quiet and opaque.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep ambient gradients around opaque panels and preserve the violet-action/pink-total roles in both themes.",
      "**Do** align process column labels with their controls and keep every mobile navigation step visible.",
      "**Do** keep mobile rows compact while offering the full activity name in a dialog.",
      "**Do** preserve automatic theme selection, the persistent user override, and white A4 printing."
    ],
    "donts": [
      "**Don't** revive the discarded teal, navy, or multicolor category-header concepts.",
      "**Don't** add a persistent mobile summary or transfer application gradients into printed output.",
      "**Don't** turn illustrative reference content into a limit on the original editable fields."
    ]
  }
}
