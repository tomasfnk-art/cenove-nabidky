      "css": ".ds-summary{font:16px/1.5 system-ui,sans-serif;background:var(--card,#fff);color:var(--fg,#21172e);border:1px solid var(--bd,#ded5e9);border-radius:12px;padding:20px}.ds-summary h3{font-size:18px;margin:0 0 20px}.ds-line{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:14px}.ds-line b{flex-shrink:0;font-variant-numeric:tabular-nums}.ds-total{font-size:18px;border-top:1px solid var(--bd,#ded5e9);margin-top:6px}.ds-total b{color:var(--pink,#ab198a)}"
    }
