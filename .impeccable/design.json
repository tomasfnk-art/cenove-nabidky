      "css": ".ds-field{font-family:system-ui,sans-serif;font-size:15px;line-height:1.5;width:100%;min-width:0;min-height:48px;padding:8px 10px;border:1px solid var(--bd,#ded5e9);border-radius:7px;background:var(--field,#f8f5fc);color:var(--fg,#21172e);caret-color:var(--pink,#ab198a);transition:border-color .16s,background .16s}.ds-field::placeholder{color:var(--mu,#685a78);opacity:1}.ds-field:focus-visible{outline:2px solid var(--ac,#6843ed);outline-offset:3px;}"
    },
    {
      "name": "Step Navigation",
      "kind": "nav",
      "description": "Current step filled violet; six compact mobile tabs share the available width.",
      "html": "<nav class=\"ds-tabs\"><button>Projekty</button><button>Základ</button><button aria-current=\"step\">Procesy</button><button>Externí</button><button>Shrnutí</button><button>Náhled</button></nav>",
      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;padding:12px 24px 20px}.ds-tabs button{font-family:system-ui,sans-serif;font-size:15px;line-height:1.5;min-height:44px;padding:0 14px;border-radius:8px;border:1px solid var(--bd,#ded5e9);cursor:pointer;font-weight:600;transition:border-color .16s,background .16s;background:transparent;border-color:transparent;color:var(--fg,#21172e);white-space:nowrap}.ds-tabs button[aria-current=\"step\"]{background:var(--ac,#6843ed);color:white}.ds-tabs button:hover{border-color:var(--ac,#6843ed)}.ds-tabs button:focus-visible{outline:2px solid var(--ac,#6843ed);outline-offset:3px;}@media(max-width:719px){.ds-tabs{gap:0;overflow:visible;padding:6px 8px 14px}.ds-tabs button{flex:1;min-width:0;padding:0 3px;font-size:12px}}"
